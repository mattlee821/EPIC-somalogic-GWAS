# EPIC Somalogic GWAS environment.
#
# Replace the /WHERE/... placeholder paths below. This file is kept fixed in the
# repository: put real values in an untracked server.env, and never commit them.

# --- Core paths -------------------------------------------------------------
# The root directory of the project (code)
GWAS_PROJECT_ROOT="/WHERE/EPIC-somalogic-GWAS"

# Output directory for this run's results (scratch). Set this to the named run
GWAS_RESULTS_DIR="/WHERE/epic-gwas/batch1"

# Nextflow work directory (scratch). Used by pipeline/nextflow.config.
GWAS_WORK_DIR="/WHERE/epic-gwas/work"

# SLURM partition for all pipeline tasks
GWAS_PARTITION="/WHERE/partition"

# Maximum number of tasks submitted to SLURM at once
GWAS_QUEUE_SIZE=500

# --- Source data paths ------------------------------------------------------
# Imputation pipeline output, one sub-directory per study
GWAS_SOURCE_GENETICS_DIR="/WHERE/genetics/finalised_data"

# Analysis-ready genotype directory written by 002_data-genetics.sh (scratch)
GWAS_GENETICS_DIR="/WHERE/epic-gwas/data/genetics"

# Phenotype file, generated by 003_data-phenotype.R (scratch)
GWAS_PHENO_FILE="/WHERE/epic-gwas/data/phenotype/phenofile.txt"

# Protein list, generated by 003_data-phenotype.R (scratch)
GWAS_INCLUDE_PROTEINS="/WHERE/epic-gwas/data/phenotype/test-10.txt"

# Samplesheet (scratch)
GWAS_SAMPLESHEET="/WHERE/epic-gwas/pipeline/samplesheet.csv"

# --- Tools and external resources -------------------------------------------
# METAL binary installed by 001_source.sh
GWAS_METAL_BIN="/WHERE/EPIC-somalogic-GWAS/pipeline/tools/metal/metal"

# Normalised SomaScan data used by the R scripts
GWAS_EXTERNAL_SOMA_RDS="/WHERE/somalogic/normalised.rds"

# Source of study .psam sample IDs for phenotype building
GWAS_DEPOT_GENETICS_DIR="/WHERE/genetics"

# --- Staging ----------------------------------------------------------------
# Staging directory written by 006_staging.sh
GWAS_STAGING_DIR="/WHERE/epic-gwas/transfer"
