# EPIC Somalogic GWAS, stratified pipeline environment.
#
# Replace the /WHERE/... placeholder paths below. This file is kept fixed in the
# repository: put real values in an untracked server.env, and never commit them.
# This tree needs its own values, so that it never shares a work directory or
# phenotype directory with pipeline/.

# --- Core paths -------------------------------------------------------------
GWAS_PROJECT_ROOT="/WHERE/EPIC-somalogic-GWAS/pipeline-strata"
GWAS_RESULTS_DIR="/WHERE/epic-gwas/results-strata"
GWAS_WORK_DIR="/WHERE/epic-gwas/work-strata"
GWAS_PARTITION="/WHERE/partition"
GWAS_QUEUE_SIZE=500

# --- Source data paths ------------------------------------------------------
GWAS_SOURCE_GENETICS_DIR="/WHERE/genetics/finalised_data"
GWAS_GENETICS_DIR="/WHERE/epic-gwas/data/genetics"
GWAS_PHENO_DIR="/WHERE/epic-gwas/data/phenotype-strata"
GWAS_PHENO_FILE="/WHERE/epic-gwas/data/phenotype-strata/phenofile.txt"
GWAS_INCLUDE_PROTEINS="/WHERE/epic-gwas/data/phenotype-strata/test-10.txt"
GWAS_SAMPLESHEET="/WHERE/EPIC-somalogic-GWAS/pipeline-strata/pipeline/samplesheet.csv"

# --- Tools and external resources -------------------------------------------
GWAS_ENV_DIR="/WHERE/EPIC-somalogic-GWAS/env"
GWAS_PARAMS_FILE="/WHERE/EPIC-somalogic-GWAS/pipeline-strata/pipeline/params.yaml"
GWAS_METAL_BIN="/WHERE/EPIC-somalogic-GWAS/pipeline/tools/metal/metal"
GWAS_EXTERNAL_SOMA_RDS="/WHERE/somalogic/normalised.rds"

# --- Staging ----------------------------------------------------------------
GWAS_STAGING_DIR="/WHERE/epic-gwas/transfer-strata"
