# --- Core Paths ---
# The root directory of the GWAS project (code)
GWAS_PROJECT_ROOT="/WHERE/Somalogic/work/GWAS"

# Output directory for this run's results (scratch). Set this to the named
# run directory, e.g. ../epic-gwas/batch1, ../epic-gwas/test-10, etc.
GWAS_RESULTS_DIR="../epic-gwas/batch1"

# Nextflow work directory (scratch). Used by pipeline/nextflow.config.
GWAS_WORK_DIR="../epic-gwas/work"

# SLURM partition for ALL pipeline tasks (one global knob; read by
GWAS_PARTITION="high_p"

# Max number of tasks submitted to SLURM at once (reduces I/O contention).
GWAS_QUEUE_SIZE=500

# --- Source Data Paths ---
# Imputation-pipeline final output: one sub-dir per study, each with
GWAS_SOURCE_GENETICS_DIR="../Genetics/work/2026-06-17"

# Local analysis-ready genotype directory written by 002_data-genetics.sh (scratch)
GWAS_GENETICS_DIR="../epic-gwas/data/genetics"

# Path to the phenotype file (generated by 003_data-phenotype.R; scratch)
GWAS_PHENO_FILE="../epic-gwas/data/phenotype/phenofile.txt"

# Path to the include proteins file (generated by 003_data-phenotype.R; scratch)
GWAS_INCLUDE_PROTEINS="../epic-gwas/data/phenotype/test-10.txt"

# Path to the samplesheet (generated by 004_samplesheet.R; scratch)
GWAS_SAMPLESHEET="../epic-gwas/pipeline/samplesheet.csv"

# --- Tools and External Resources ---
# Path to the bundled METAL binary (under the project pipeline/tools)
GWAS_METAL_BIN="../metal"

# Path to external RDS files used in R scripts
GWAS_EXTERNAL_SOMA_RDS="/WHERE/Somalogic/proteomics/NormalizedSoma_PlateCorrAccountforDisease_InvRank.rds"

# Source of study .psam sample IDs for phenotype building (003_data-phenotype.R).
GWAS_DEPOT_GENETICS_DIR="../genetics"

# --- Transfer ---
# Local staging directory — files are copied here by 006_staging.sh before upload.
GWAS_STAGING_DIR="../epic-gwas/transfer"

