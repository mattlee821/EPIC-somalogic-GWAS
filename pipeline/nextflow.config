// =============================================================================
// Usage:
//   nextflow run pipeline.nf -profile slurm
//   nextflow run pipeline.nf -profile test
// =============================================================================

conda.enabled = true
// The regenie env is large and the transaction-verify step is slow on NFS
// scratch, overrunning Nextflow's default 20-min env-build limit (kill -> exit
// 143). Allow longer one-time builds.
conda.createTimeout = '1 h'

process {
  cache         = true
  cpus          = 1
  memory        = '4.GB'
  time          = '1.h'
  errorStrategy = 'terminate'
  maxRetries    = 0

  // Requests are right-sized to observed peak usage (+headroom) so SLURM packs as
  // many concurrent jobs per node as possible. The per-protein fan-out jobs
  // (REGENIE_STEP1/STEP2, GWAS_QC) dominate concurrency, so they are kept lean;
  // the per-study jobs (LD_PRUNING, VARIANT_QC, REGENIE_STEP0) run only ~13x and
  // are provisioned for safety. Comments note observed peak RSS.
  withName: VALIDATE_INPUTS    { cpus = 1; memory = '2.GB';  time = '1.h' }
  withName: PREPARE_PHENOTYPES { cpus = 1; memory = '4.GB';  time = '1.h' }   // ~2.9 GB
  withName: PREPARE_COVARIATES { cpus = 1; memory = '4.GB';  time = '1.h' }   // ~2.9 GB
  withName: VARIANT_QC         { cpus = 1; memory = '6.GB';  time = '3.h' }   // IO-bound (~10% cpu), ~4.7 GB
  withName: STAGE_VARIANT_QC   { cpus = 1; memory = '1.GB';  time = '1.h' }   // trivial
  withName: LD_PRUNING         { cpus = 2; memory = '14.GB'; time = '8.h' }   // ~10.8 GB peak
  withName: PCA                { cpus = 2; memory = '2.GB';  time = '2.h' }   // ~0.9 GB peak RSS; large cohorts take ~55 min
  withName: ADD_PCS            { cpus = 1; memory = '1.GB';  time = '1.h' }   // ~50 MB
  withName: REGENIE_STEP0      { cpus = 2; memory = '2.GB';  time = '2.h' }   // ~0.6 GB
  withName: REGENIE_STEP1      { cpus = 1; memory = '4.GB';  time = '1.h'; scratch = true }   // ~3.2 GB, ~13 min
  withName: REGENIE_STEP2      { cpus = 1; memory = '1.GB';  time = '3.h'; scratch = true }   // ~0.35 GB; realtime can approach cap
  withName: GWAS_QC            { cpus = 2; memory = '6.GB';  time = '2.h' }   // ~4.9 GB
  withName: META_GROUP         { cpus = 1; memory = '6.GB';  time = '8.h' }
  withName: META_STUDY         { cpus = 1; memory = '6.GB';  time = '8.h' }   // ~4.7 GB; reads 13 study sumstats + METAL, IO-bound under load
  // LDSC/HERITABILITY are diagnostics with cache disabled: their bin scripts
  // (run_ldsc.sh / run_herit.sh) and the reference data they read are not part of
  // Nextflow's task hash, so caching them risks stale results -- always re-run.
  withName: LDSC               { cpus = 1; memory = '4.GB';  time = '1.h'; cache = false }   // munge + ldsc --h2 per protein, ~0.5 GB, ~1-2 min
  withName: HERITABILITY       { cpus = 2; memory = '8.GB';  time = '2.h'; cache = false }   // plink --clump on the combined LD ref + LDSC remainder
  withName: COHORT_SUMMARY     { cpus = 1; memory = '1.GB';  time = '1.h' }
}

profiles {

  // ---------------------------------------------------------------------------
  // slurm — base SLURM profile: partitions, memory, error handling.
  // Queue size caps the number of active submitted Slurm tasks for this run.
  // ---------------------------------------------------------------------------
  slurm {
    // Nextflow work directory on NFS scratch (not /home or the project root),
    // so all intermediate task files live under /WHERE/epic-gwas.
    workDir = System.getenv('GWAS_WORK_DIR') ?: '/WHERE/epic-gwas/work'

    process {
      executor      = 'slurm'
      // Single global knob for the SLURM partition of every pipeline task.
      // Set GWAS_PARTITION in .env (e.g. high_p for test runs, low_p for the
      // full run); falls back to low_p if unset.
      queue         = System.getenv('GWAS_PARTITION') ?: 'low_p'
      errorStrategy = { task.exitStatus in [130, 137, 139, 140, 143] ? 'retry' : 'finish' }
      maxRetries    = 2

      withName: REGENIE_STEP0 {
        cpus          = 2
        memory        = '2.GB'
        time          = '2.h'
        errorStrategy = 'terminate'
        maxRetries    = 0
      }
      withName: REGENIE_STEP1 {
        cpus          = 1
        memory        = '4.GB'
        time          = '1.h'
        scratch       = true
        errorStrategy = 'terminate'
        maxRetries    = 0
      }
      withName: REGENIE_STEP2 {
        cpus    = 1
        memory  = '6.GB'   // peak RSS 3.7 GB; 6 GB headroom
        time    = '6.h'    // normal ~10 min; can reach ~3h under I/O load
        scratch = true
      }
      withName: GWAS_QC {
        cpus   = 2
        memory = '8.GB'    // peak RSS 6.6 GB observed; 8 GB headroom
        time   = '4.h'     // normal ~44 min; can reach ~2h under I/O load
      }
      withName: META_GROUP {
        cpus   = 1
        memory = '8.GB'
        time   = '8.h'
      }
      withName: META_STUDY {
        cpus   = 1
        memory = '8.GB'
        time   = '8.h'
      }
    }
    executor {
      name            = 'slurm'
      queueSize       = (System.getenv('GWAS_QUEUE_SIZE') ?: '500').toInteger()
      submitRateLimit = '1000/1min'
      pollInterval    = '30 sec'    // How often Nextflow polls SLURM to refresh job states.
      exitReadTimeout = '10 min'    // How long Nextflow waits to read final task metadata after a job exits.
      jobName         = { "${task.process.tokenize(':').last()}_${task.index}" }
    }
  }

  // ---------------------------------------------------------------------------
  // test — local execution for pipeline development
  // ---------------------------------------------------------------------------
  test {
    params {
      chunk_size  = 3
      chromosomes = [21]
    }
    process {
      executor = 'local'
      cpus     = 2
      memory   = '8.GB'
    }
  }

}

report {
  enabled = true
  file    = "${params.outdir}/pipeline_info/execution_report.html"
  overwrite = true
}

timeline {
  enabled = true
  file    = "${params.outdir}/pipeline_info/execution_timeline.html"
  overwrite = true
}

trace {
  enabled = true
  file    = "${params.outdir}/pipeline_info/execution_trace.txt"
  overwrite = true
}
